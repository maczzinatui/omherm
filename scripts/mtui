#!/run/current-system/sw/bin/bash
# mtui / omh — Hermes product cockpit (restored known-good launch path)
set -euo pipefail
ROOT="${MESHINA_TUI_ROOT:-${OMHERM_ROOT:-}}"
if [[ -z "${ROOT}" ]]; then
  HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [[ -d "$HERE/../packages/coding-agent" ]]; then
    ROOT="$(cd "$HERE/.." && pwd)"
  elif [[ -d "$HOME/omherm/packages/coding-agent" ]]; then
    ROOT="$HOME/omherm"
  elif [[ -d "$HOME/meshina-tui/packages/coding-agent" ]]; then
    ROOT="$HOME/meshina-tui"
  else
    ROOT="$HOME/omherm"
  fi
fi
if [[ ! -d "$ROOT/packages/coding-agent" ]]; then
  echo "mtui: coding-agent not found under $ROOT (set MESHINA_TUI_ROOT or OMHERM_ROOT)" >&2
  exit 1
fi
BUN="${BUN:-$HOME/.bun/bin/bun}"
[[ -x "$BUN" ]] || BUN="$(command -v bun || true)"
[[ -n "${BUN:-}" ]] || { echo "mtui: bun not found" >&2; exit 127; }

# EXACT product gates from last good dogfood (6b47bcd)
export MESHINA_TUI_BRAND=hermes
export MESHINA_TUI_VERSION="${MESHINA_TUI_VERSION:-0.1.0-hermes}"
# public name aliases (optional; gates use hermes above)
export OMHERM_BRAND=omherm
export OMHERM_VERSION="${OMHERM_VERSION:-0.1.0}"

if [[ -z "${HERMES_PYTHON:-}" && -x "$HOME/.hermes/hermes-agent/venv/bin/python" ]]; then
  export HERMES_PYTHON="$HOME/.hermes/hermes-agent/venv/bin/python"
fi
if [[ -z "${HERMES_AGENT_ROOT:-}" && -d "$HOME/.hermes/hermes-agent" ]]; then
  export HERMES_AGENT_ROOT="$HOME/.hermes/hermes-agent"
fi

# Workspace = caller's directory (where the operator ran `omh`), NOT the coat
# checkout. Old `cd "$ROOT"` forced footer + Hermes session.create cwd to
# ~/omherm even when launched from meshina/stable/mesh-beta. Bun resolves the
# entry by absolute path; do not chdir into the coat tree.
CALLER_CWD="$(pwd -P 2>/dev/null || pwd)"
export HERMES_CWD="${HERMES_CWD:-$CALLER_CWD}"
export OMHERM_LAUNCH_CWD="$CALLER_CWD"

exec "$BUN" "$ROOT/packages/coding-agent/src/mtui.ts" "$@"