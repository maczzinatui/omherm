#!/usr/bin/env bash
# mtui — Hermes Agent cockpit
set -euo pipefail
ROOT="${MESHINA_TUI_ROOT:-$HOME/meshina-tui}"
if [[ ! -d "$ROOT/packages/coding-agent" ]]; then
  HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [[ -d "$HERE/../packages/coding-agent" ]]; then
    ROOT="$(cd "$HERE/.." && pwd)"
  fi
fi
if [[ ! -d "$ROOT/packages/coding-agent" ]]; then
  echo "mtui: coding-agent not found under $ROOT (set MESHINA_TUI_ROOT)" >&2
  exit 1
fi
BUN="${BUN:-$HOME/.bun/bin/bun}"
[[ -x "$BUN" ]] || BUN="$(command -v bun || true)"
[[ -n "${BUN:-}" ]] || { echo "mtui: bun not found" >&2; exit 127; }

export MESHINA_TUI_BRAND=hermes
export MESHINA_TUI_VERSION="${MESHINA_TUI_VERSION:-0.1.0-hermes}"
if [[ -z "${HERMES_PYTHON:-}" && -x "$HOME/.hermes/hermes-agent/venv/bin/python" ]]; then
  export HERMES_PYTHON="$HOME/.hermes/hermes-agent/venv/bin/python"
fi
if [[ -z "${HERMES_AGENT_ROOT:-}" && -d "$HOME/.hermes/hermes-agent" ]]; then
  export HERMES_AGENT_ROOT="$HOME/.hermes/hermes-agent"
fi

cd "$ROOT"
# Always Hermes product entry (not stock OMP CLI)
exec "$BUN" "$ROOT/packages/coding-agent/src/mtui.ts" "$@"
